# Copy to .env in this directory. .env is ignored by Git.
# Fill in the API key and your per-request reservation amount before live use.
MANGA_PROVIDER=gemini
MANGA_ENABLE_LIVE=1
GEMINI_API_KEY=
# T14: 2 initial pages + 1 revised page. Cumulative limit for this data directory.
MANGA_LIVE_MAX_REQUESTS=3
# Positive integer in micro USD; internal reservation, not a guaranteed billing cap.
MANGA_LIVE_UNIT_RESERVE_MICRO_USD=
# Keep live acceptance data separate from the existing mock workspace.
MANGA_DATA_DIR=.data/live-acceptance
