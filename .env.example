# Gemini 実API検証の設定
# 「1. 入力する項目」の2か所を記入して保存してください。
# このファイルはGitへ送信されません。APIキーはチャットにも貼らないでください。

# ── 1. 入力する項目 ──────────────────────────

# APIキー：取得したGemini APIキーを「=」の右側に貼り付けます。
GEMINI_API_KEY=

# 1要求あたりの予算予約額：正の整数を入力します。
# 単位：1ドル = 1,000,000。計算例：0.10ドル分を予約するなら 100000。
# これはアプリ内の予算管理用です。実際の料金の見積りや請求の強制上限ではありません。
MANGA_LIVE_UNIT_RESERVE_MICRO_USD=

# ── 2. 検証用の設定（通常は変更不要）────────────────

# 送信要求数の上限：初回2ページ＋1ページの修正再生成で、合計3要求。
# この保存先での累積上限です。失敗した要求の予約枠も消費します。
MANGA_LIVE_MAX_REQUESTS=3

# 利用するAPI：gemini = 実API、mock = 課金なしの模擬API。
MANGA_PROVIDER=gemini

# 実API送信の有効化：1 = 有効、0 = 無効。
# APIキー・要求数上限・予算予約額も揃うまで送信されません。
MANGA_ENABLE_LIVE=1

# 検証データの保存先：既存のモック用データとは別に保存します。
MANGA_DATA_DIR=.data/live-acceptance
