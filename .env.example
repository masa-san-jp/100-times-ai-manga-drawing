# Gemini 実API検証の設定
# このテンプレートを .env にコピーし、.env の最初の2項目を記入してください。
# Git対象外なのは .env だけです。このテンプレートには実際のAPIキーを書かないでください。
# APIキーはチャットにも貼らないでください。

# ── 入力する項目 ────────────────────────────

# ① GeminiのAPIキー
GEMINI_API_KEY=

# ② 画像1枚に見込む費用（米ドル）
# ドル額をそのまま入力します。例：0.10 は10セント、1.00 は1ドル。
# アプリ内の予算管理に使います。実際の請求額をこの金額で止める設定ではありません。
MANGA_LIVE_BUDGET_PER_IMAGE_USD=

# ── 設定済みの項目（通常は変更不要）─────────────────

# 生成する画像の上限：初回2枚＋修正1枚＝合計3枚。
# この保存先での累積要求数です。失敗分も枠を使うため、成功画像数とは異なります。
MANGA_LIVE_MAX_REQUESTS=3

# 利用するAPI：gemini = 実API、mock = 模擬API。
MANGA_PROVIDER=gemini

# 実API送信：1 = 有効、0 = 無効。上の2項目が空欄の間は送信しません。
MANGA_ENABLE_LIVE=1

# 検証データの保存先（既存のモック用データとは別に保存）。
MANGA_DATA_DIR=.data/live-acceptance
